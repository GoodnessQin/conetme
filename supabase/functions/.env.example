# Secrets for the server functions. Set these in Supabase: Edge Functions, Secrets. Never put them in the app or in Git.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# Payments (Paystack). Use the TEST secret key first.
PAYSTACK_SECRET_KEY=sk_test_xxx
APP_URL=https://your-app.vercel.app
PAYMENT_EMAIL_DOMAIN=pay.connectme.ng
CRON_SECRET=make_a_long_random_string

# SMS: sendchamp or termii
SMS_PROVIDER=sendchamp
SENDCHAMP_API_KEY=xxx
SENDCHAMP_SENDER=ConnectMe
SENDCHAMP_ROUTE=dnd
TERMII_API_KEY=xxx
TERMII_SENDER_ID=ConnectMe
TERMII_CHANNEL=dnd
SEND_SMS_HOOK_SECRET=v1,whsec_from_supabase
WEBHOOK_SECRET=make_another_long_random_string

# Identity checks (Dojah). Sandbox base URL: https://sandbox.dojah.io  (sandbox test NIN: 70123456789)
KYC_PROVIDER=dojah
DOJAH_SECRET_KEY=xxx
DOJAH_APP_ID=xxx
DOJAH_BASE_URL=https://api.dojah.io
